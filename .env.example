# Copy to .env.local (git-ignored) and fill in. Expo loads it when you run `npm start`.
# EXPO_PUBLIC_* values are built into the app and readable by anyone: never put secrets here.

# Origin of the Mavelle API (Mavellee/server), without /api. Must be https outside development.
#   iOS simulator:      http://localhost:4000
#   Android emulator:   http://10.0.2.2:4000
#   Physical phone:     http://<your Mac's LAN IP>:4000  (same Wi-Fi as the Mac)
EXPO_PUBLIC_API_URL=http://localhost:4000
